# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀（nginx 会代理 /api/* 到 java-service:8080）
VITE_API_URL = /api

# 生产环境 WebSocket 走 nginx 代理，无需硬编码地址（由前端根据 window.location 自动推导）
VITE_API_WEBSOCKET_URL = ws://www.expresswaydetect.site

# Delete console
VITE_DROP_CONSOLE = true